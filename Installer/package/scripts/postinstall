#!/bin/bash
# Post-install script for Rane SL 2 macOS Driver

chown -R root:wheel "/Library/Audio/Plug-Ins/HAL/SL2Device.driver"
chmod -R 755 "/Library/Audio/Plug-Ins/HAL/SL2Device.driver"

chown -R root:wheel "/Library/Frameworks/SL2Api.framework"
chmod -R 755 "/Library/Frameworks/SL2Api.framework"

chown -R root:wheel "/Applications/SL 2 Control Panel.app"
chmod -R 755 "/Applications/SL 2 Control Panel.app"

chown -R root:wheel "/Library/Extensions/SL2.10.9.kext"
chmod -R 755 "/Library/Extensions/SL2.10.9.kext"

if [ -f "/usr/local/bin/sl2panel" ]; then
    chown root:wheel "/usr/local/bin/sl2panel"
    chmod 755 "/usr/local/bin/sl2panel"
fi

# Remove quarantine attributes if present
xattr -dr com.apple.quarantine "/Library/Audio/Plug-Ins/HAL/SL2Device.driver" 2>/dev/null || true
xattr -dr com.apple.quarantine "/Library/Frameworks/SL2Api.framework" 2>/dev/null || true
xattr -dr com.apple.quarantine "/Applications/SL 2 Control Panel.app" 2>/dev/null || true

# Restart CoreAudio daemon so the SL 2 HAL driver loads immediately without rebooting
killall -9 coreaudiod 2>/dev/null || launchctl kickstart -kp system/com.apple.audio.coreaudiod 2>/dev/null || true

exit 0
